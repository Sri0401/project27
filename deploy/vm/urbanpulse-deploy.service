[Unit]
Description=UrbanPulse pull-based deployment (deploys main after CI passes)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=azureuser
Environment=HOME=/home/azureuser
ExecStart=/bin/bash /home/azureuser/urbanpulse/deploy/vm/deploy.sh
TimeoutStartSec=20min
