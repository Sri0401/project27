# Copy to .env and change every value. Never commit .env.
# Use letters and digits only, because the passwords are placed inside connection URLs.
POSTGRES_PASSWORD=change-me-postgres
MONGO_PASSWORD=change-me-mongo
# Needed in the X-API-Key header for POST /api/datasets. Leave empty to switch writes off.
API_KEY=change-me-api-key
# Host port for the website.
WEB_PORT=8080
